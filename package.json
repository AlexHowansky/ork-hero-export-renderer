{
  "name": "hero-export-renderer",
  "version": "0.1.0",
  "description": "Render HERO System character sheets by applying a HERO Designer export template (.hde) to a character file (.hdc).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "hero-extract-rules": "./src/cli/extract-rules.ts"
  },
  "files": [
    "src",
    "rules"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "extract-rules": "bun run src/cli/extract-rules.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
