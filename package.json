{
  "name": "ork-hero-export-renderer",
  "version": "0.9.0",
  "description": "Render HERO System character sheets by applying a HERO Designer export template (.hde) to a character file (.hdc).",
  "license": "MIT",
  "author": "Alex Howansky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexHowansky/ork-hero-export-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/AlexHowansky/ork-hero-export-renderer/issues"
  },
  "homepage": "https://github.com/AlexHowansky/ork-hero-export-renderer#readme",
  "type": "module",
  "sideEffects": [
    "./dist/cli/*.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./hdc": {
      "types": "./dist/hdc/index.d.ts",
      "default": "./dist/hdc/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./xml": {
      "types": "./dist/xml/parse.d.ts",
      "default": "./dist/xml/parse.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "default": "./dist/util/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ork-hero-render": "./dist/cli/render.js",
    "ork-hero-extract-rules": "./dist/cli/extract-rules.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/render.js dist/cli/extract-rules.js",
    "pack:check": "bun pm pack --dry-run",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "extract-rules": "bun run src/cli/extract-rules.ts",
    "render": "bun run src/cli/render.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "hero-system",
    "hero-designer",
    "character-sheet",
    "hdc",
    "hde",
    "rpg"
  ]
}
